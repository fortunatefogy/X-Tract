{"data":{"id":"oQCzt0q6K16","screenId":"aYrNq3rTjtW","name":"Settings","activeVersion":1,"versions":[{"id":"C05LkoSPGkz","version":1,"code":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Settings</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@100;200;300;400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100;200;300;400;500;600;700;800&display=swap\"\n      rel=\"stylesheet\"\n    />\n    <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>\n    <script src=\"https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js\"></script>\n    <style type=\"text/tailwindcss\">\n      @theme inline {\n        --color-background: var(--background);\n        --color-foreground: var(--foreground);\n        --color-primary: var(--primary);\n        --color-primary-foreground: var(--primary-foreground);\n        --color-secondary: var(--secondary);\n        --color-secondary-foreground: var(--secondary-foreground);\n        --color-muted: var(--muted);\n        --color-muted-foreground: var(--muted-foreground);\n        --color-accent: var(--accent);\n        --color-accent-foreground: var(--accent-foreground);\n        --color-destructive: var(--destructive);\n        --color-destructive-foreground: var(--destructive-foreground);\n        --color-card: var(--card);\n        --color-card-foreground: var(--card-foreground);\n        --color-popover: var(--popover);\n        --color-popover-foreground: var(--popover-foreground);\n        --color-border: var(--border);\n        --color-input: var(--input);\n        --color-ring: var(--ring);\n        --color-chart-1: var(--chart-1);\n        --color-chart-2: var(--chart-2);\n        --color-chart-3: var(--chart-3);\n        --color-chart-4: var(--chart-4);\n        --color-chart-5: var(--chart-5);\n\n        --font-sans: var(--font-sans);\n        --font-heading: var(--font-heading, var(--font-sans));\n        --font-serif: var(--font-serif);\n        --font-mono: var(--font-mono);\n      }\n\n      @theme {\n        --radius-xs: calc(var(--radius) - 8px);\n        --radius-sm: calc(var(--radius) - 4px);\n        --radius-md: calc(var(--radius) - 2px);\n        --radius-lg: var(--radius);\n        --radius-xl: calc(var(--radius) + 4px);\n        --radius-2xl: calc(var(--radius) + 8px);\n        --radius-3xl: calc(var(--radius) + 16px);\n        --radius-4xl: calc(var(--radius) + 24px);\n      }\n\n      * {\n        corner-shape: var(--shape, round);\n      }\n\n      .rounded-full,\n      .rounded-none,\n      .rounded-t-full,\n      .rounded-t-none,\n      .rounded-r-full,\n      .rounded-r-none,\n      .rounded-b-full,\n      .rounded-b-none,\n      .rounded-l-full,\n      .rounded-l-none,\n      .rounded-s-full,\n      .rounded-s-none,\n      .rounded-e-full,\n      .rounded-e-none,\n      .rounded-tl-full,\n      .rounded-tl-none,\n      .rounded-tr-full,\n      .rounded-tr-none,\n      .rounded-bl-full,\n      .rounded-bl-none,\n      .rounded-br-full,\n      .rounded-br-none,\n      .rounded-ss-full,\n      .rounded-ss-none,\n      .rounded-se-full,\n      .rounded-se-none,\n      .rounded-es-full,\n      .rounded-es-none,\n      .rounded-ee-full,\n      .rounded-ee-none {\n        corner-shape: round;\n      }\n\n      @utility rounded-* {\n        border-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-t-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-r-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-b-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-l-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tl-* {\n        border-top-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-tr-* {\n        border-top-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-bl-* {\n        border-bottom-left-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-br-* {\n        border-bottom-right-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-s-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-e-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ss-* {\n        border-start-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-se-* {\n        border-start-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-es-* {\n        border-end-start-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n      @utility rounded-ee-* {\n        border-end-end-radius: calc(\n          --value(--radius-*, [length], [percentage]) * var(--shape-multiplier, 1)\n        );\n      }\n\n      @layer base {\n        * {\n          @apply border-border outline-ring/50;\n        }\n        body {\n          @apply bg-background text-foreground font-sans;\n        }\n      }\n\n      :root {\n        --shape: squircle;\n        --shape-multiplier: 1;\n\n        --background: #f6f7fa;\n        --foreground: #13151c;\n        --primary: #6c3bf4;\n        --primary-foreground: #ffffff;\n        --secondary: #ebedf3;\n        --secondary-foreground: #1d2030;\n        --muted: #eff1f6;\n        --muted-foreground: #6a7080;\n        --accent: #eee9ff;\n        --accent-foreground: #4b22c4;\n        --destructive: #e5484d;\n        --destructive-foreground: #ffffff;\n        --card: #ffffff;\n        --card-foreground: #13151c;\n        --popover: #ffffff;\n        --popover-foreground: #13151c;\n        --border: #e2e5ed;\n        --input: #eff1f6;\n        --ring: #6c3bf4;\n        --chart-1: #6c3bf4;\n        --chart-2: #14b8a6;\n        --chart-3: #f59e0b;\n        --chart-4: #e5484d;\n        --chart-5: #5b6275;\n\n        --font-sans: \"Manrope\", sans-serif;\n        --font-heading: \"Outfit\", sans-serif;\n        --font-serif: \"Playfair Display\", serif;\n        --font-mono: \"JetBrains Mono\", monospace;\n\n        --radius: 1rem;\n      }\n\n      @supports (corner-shape: squircle) {\n        :root {\n          --shape-multiplier: 2.5;\n        }\n      }\n\n      /* Prevent layout shift for icons without explicit dimensions */\n      iconify-icon:not([width]):not([height]) {\n        display: inline-block;\n        width: 1em;\n        height: 1em;\n      }\n\n      /* Hide scrollbars */\n      *,\n      *::before,\n      *::after {\n        scrollbar-width: none;\n        -ms-overflow-style: none;\n      }\n      *::-webkit-scrollbar {\n        display: none;\n      }\n    </style>\n  </head>\n  <body>\n    <div>\n      <div class=\"min-h-screen bg-background text-foreground font-sans pb-32\">\n        <div class=\"px-5 pt-12\">\n          <h1 class=\"font-heading text-3xl font-extrabold tracking-tight\">Settings</h1>\n          <p class=\"text-sm text-muted-foreground mt-1\">Tune how Linky finds and saves media.</p>\n        </div>\n        <div class=\"px-5 mt-6\">\n          <p class=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-2 px-1\">\n            Appearance\n          </p>\n          <div class=\"bg-card border border-border rounded-2xl p-4\">\n            <p class=\"text-sm font-semibold\">Theme</p>\n            <div class=\"mt-3 bg-secondary rounded-full p-1 flex\">\n              <button class=\"flex-1 h-9 rounded-full text-sm font-medium text-muted-foreground\">\n                Light</button\n              ><button class=\"flex-1 h-9 rounded-full bg-card text-sm font-semibold shadow-none\">\n                Dark</button\n              ><button class=\"flex-1 h-9 rounded-full text-sm font-medium text-muted-foreground\">\n                System\n              </button>\n            </div>\n          </div>\n        </div>\n        <div class=\"px-5 mt-6\">\n          <p class=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-2 px-1\">\n            Browser\n          </p>\n          <div class=\"bg-card border border-border rounded-2xl divide-y divide-border\">\n            <div class=\"flex items-center gap-3 p-4\">\n              <div class=\"flex-1\">\n                <p class=\"text-sm font-semibold\">Open links in browser</p>\n                <p class=\"text-xs text-muted-foreground mt-0.5\">Shared pages open inside Linky</p>\n              </div>\n              <div class=\"w-11 h-6 rounded-full bg-primary relative\">\n                <span class=\"absolute right-0.5 top-0.5 size-5 rounded-full bg-white\"></span>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-3 p-4\">\n              <div class=\"flex-1\">\n                <p class=\"text-sm font-semibold\">Search engine</p>\n                <p class=\"text-xs text-muted-foreground mt-0.5\">Used for plain-text queries</p>\n              </div>\n              <div class=\"flex items-center gap-1 text-sm text-muted-foreground\">\n                DuckDuckGo<iconify-icon icon=\"ph:caret-down\" width=\"16\" height=\"16\"></iconify-icon>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-3 p-4\">\n              <div class=\"flex-1\">\n                <p class=\"text-sm font-semibold\">Desktop mode</p>\n                <p class=\"text-xs text-muted-foreground mt-0.5\">Request full websites</p>\n              </div>\n              <div class=\"w-11 h-6 rounded-full bg-muted relative\">\n                <span\n                  class=\"absolute left-0.5 top-0.5 size-5 rounded-full bg-card shadow-none\"\n                ></span>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div class=\"px-5 mt-6\">\n          <p class=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-2 px-1\">\n            Downloads\n          </p>\n          <div class=\"bg-card border border-border rounded-2xl divide-y divide-border\">\n            <div class=\"flex items-center gap-3 p-4\">\n              <div class=\"flex-1\">\n                <p class=\"text-sm font-semibold\">Save location</p>\n                <p class=\"text-xs text-muted-foreground mt-0.5\">Internal storage / Linky</p>\n              </div>\n              <iconify-icon\n                icon=\"ph:caret-right\"\n                class=\"text-muted-foreground\"\n                width=\"16\"\n                height=\"16\"\n              ></iconify-icon>\n            </div>\n            <div class=\"flex items-center gap-3 p-4\">\n              <div class=\"flex-1\">\n                <p class=\"text-sm font-semibold\">Parallel downloads</p>\n                <p class=\"text-xs text-muted-foreground mt-0.5\">Files transferring at once</p>\n              </div>\n              <div class=\"flex items-center gap-1 text-sm text-muted-foreground\">\n                3<iconify-icon icon=\"ph:caret-down\" width=\"16\" height=\"16\"></iconify-icon>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-3 p-4\">\n              <div class=\"flex-1\">\n                <p class=\"text-sm font-semibold\">Wi-Fi only</p>\n                <p class=\"text-xs text-muted-foreground mt-0.5\">Pause transfers on mobile data</p>\n              </div>\n              <div class=\"w-11 h-6 rounded-full bg-primary relative\">\n                <span class=\"absolute right-0.5 top-0.5 size-5 rounded-full bg-white\"></span>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div class=\"px-5 mt-6\">\n          <p class=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-2 px-1\">\n            Detection\n          </p>\n          <div class=\"bg-card border border-border rounded-2xl divide-y divide-border\">\n            <div class=\"flex items-center gap-3 p-4\">\n              <div class=\"flex-1\">\n                <p class=\"text-sm font-semibold\">Auto-detect on paste</p>\n                <p class=\"text-xs text-muted-foreground mt-0.5\">\n                  Scan links as soon as they arrive\n                </p>\n              </div>\n              <div class=\"w-11 h-6 rounded-full bg-primary relative\">\n                <span class=\"absolute right-0.5 top-0.5 size-5 rounded-full bg-white\"></span>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-3 p-4\">\n              <div class=\"flex-1\">\n                <p class=\"text-sm font-semibold\">Preferred quality</p>\n                <p class=\"text-xs text-muted-foreground mt-0.5\">Default selection in results</p>\n              </div>\n              <div class=\"flex items-center gap-1 text-sm text-muted-foreground\">\n                1080p<iconify-icon icon=\"ph:caret-down\" width=\"16\" height=\"16\"></iconify-icon>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div class=\"px-5 mt-6\">\n          <p class=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-2 px-1\">\n            Privacy\n          </p>\n          <div class=\"bg-card border border-border rounded-2xl divide-y divide-border\">\n            <div class=\"flex items-center gap-3 p-4\">\n              <div class=\"flex-1\">\n                <p class=\"text-sm font-semibold\">Save browsing history</p>\n                <p class=\"text-xs text-muted-foreground mt-0.5\">Keep visits for 90 days</p>\n              </div>\n              <div class=\"w-11 h-6 rounded-full bg-primary relative\">\n                <span class=\"absolute right-0.5 top-0.5 size-5 rounded-full bg-white\"></span>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-3 p-4\">\n              <div class=\"flex-1\">\n                <p class=\"text-sm font-semibold\">Clear browsing data</p>\n                <p class=\"text-xs text-muted-foreground mt-0.5\">Cookies, cache and history</p>\n              </div>\n              <iconify-icon\n                icon=\"ph:caret-right\"\n                class=\"text-muted-foreground\"\n                width=\"16\"\n                height=\"16\"\n              ></iconify-icon>\n            </div>\n          </div>\n        </div>\n        <div class=\"px-5 mt-6\">\n          <p class=\"text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-2 px-1\">\n            Advanced\n          </p>\n          <div class=\"bg-card border border-border rounded-2xl divide-y divide-border\">\n            <div class=\"flex items-center gap-3 p-4\">\n              <div class=\"flex-1\">\n                <p class=\"text-sm font-semibold\">Verify file integrity</p>\n                <p class=\"text-xs text-muted-foreground mt-0.5\">Checksum after each download</p>\n              </div>\n              <div class=\"w-11 h-6 rounded-full bg-muted relative\">\n                <span class=\"absolute left-0.5 top-0.5 size-5 rounded-full bg-card\"></span>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-3 p-4\">\n              <div class=\"flex-1\">\n                <p class=\"text-sm font-semibold text-destructive\">Reset all settings</p>\n                <p class=\"text-xs text-muted-foreground mt-0.5\">Keeps your library and downloads</p>\n              </div>\n              <iconify-icon\n                icon=\"ph:arrow-counter-clockwise\"\n                class=\"text-destructive\"\n                width=\"16\"\n                height=\"16\"\n              ></iconify-icon>\n            </div>\n          </div>\n          <p class=\"text-xs text-muted-foreground text-center mt-6\">Linky 2.4.0 · Build 318</p>\n        </div>\n      </div>\n      <nav class=\"fixed bottom-0 left-0 right-0 bg-card border-t border-border px-2 pt-2 pb-6 flex\">\n        <div class=\"flex-1 flex flex-col items-center gap-1 text-muted-foreground\">\n          <iconify-icon icon=\"ph:house\" width=\"24\" height=\"24\"></iconify-icon\n          ><span class=\"text-[11px] font-medium\">Home</span>\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-1 text-muted-foreground\">\n          <iconify-icon icon=\"ph:download-simple\" width=\"24\" height=\"24\"></iconify-icon\n          ><span class=\"text-[11px] font-medium\">Downloads</span>\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-1 text-muted-foreground\">\n          <iconify-icon icon=\"ph:folder-simple\" width=\"24\" height=\"24\"></iconify-icon\n          ><span class=\"text-[11px] font-medium\">Library</span>\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-1 text-primary\">\n          <iconify-icon icon=\"ph:gear-fill\" width=\"24\" height=\"24\"></iconify-icon\n          ><span class=\"text-[11px] font-semibold\">Settings</span>\n        </div>\n      </nav>\n    </div>\n  </body>\n</html>\n","createdAt":"2026-11-10T06:41:08.617743+00:00"}],"createdAt":"2026-11-10T06:41:08.617743+00:00","updatedAt":"2026-11-10T06:41:08.617743+00:00"}}